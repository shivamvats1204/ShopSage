# ShopSage reads this project's .env on every request. Never commit real keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# demo | erpnext-api | erpnext-db. Demo contains only fictional records.
DATA_MODE=demo
SHOP_NAME=Green Basket
OWNER_NAME=Shop Owner
ERP_COMPANY=Green Basket
ERP_WAREHOUSE=

# Recommended: Frappe REST API using a dedicated user with read permissions.
ERPNEXT_URL=http://127.0.0.1:8000
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Optional local source/site discovery. Use paths for the machine running ShopSage.
# Example Linux/WSL: /home/frappe/frappe-bench
FRAPPE_BENCH_PATH=
FRAPPE_SITE=
ERPNEXT_REPO_PATH=

# Optional direct MariaDB adapter. Requires pip install -r requirements-db.txt.
# Use a separate SELECT-only account, NOT the Frappe site's application account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL_CA=

# Single-company scope. Reading more than this limit fails rather than hiding rows.
MAX_ROWS=10000
CACHE_SECONDS=60
